# Copy to .env and adjust. Every setting has a safe default.

# ===== V2 runtime (default): Whisper ONNX ASR + ONNX encoder + trained heads =====
BD_SHERPA_MODEL_DIR=models/asr/hi-hinglish-swift   # most accurate: models/asr/hi-hinglish-apex (download_models.py --asr swift apex)
BD_SHERPA_EXTRA_MODEL_DIRS=models/asr/hi-hinglish-swift   # second opinion: its hypotheses join the primary model's
BD_SHERPA_LANGUAGES=hi,en             # one decoding pass per language; the NLU keeps the best hypothesis
BD_ASR_THREADS=4
BD_ASR_TIMEOUT_S=10                # ASR result older than this is discarded (no action)
BD_MAX_AUDIO_S=15                  # longer utterances are rejected (bounded buffer)
BD_NLU_ARTIFACTS=artifacts/nlu/runtime
BD_NLU_THREADS=2
BD_PROFILE_DB=data/profiles/bhashadrive.sqlite
BD_PROFILE_ID=default
BD_PERSONAL_THRESHOLDS=artifacts/personalization.json
BD_STORE_CORRECTIONS=false         # opt-in audit trail of shortcut corrections

# ===== V1 development benchmark only (python -m bhashadrive.cli --legacy-llm ...) =====

# --- Speech recognition (faster-whisper) ---
BD_ASR_MODEL=small                 # tiny | base | small | medium
BD_ASR_DEVICE=cpu                  # cpu | cuda
BD_ASR_COMPUTE_TYPE=int8           # cpu: int8 ; cuda: int8_float16 or float16
BD_ASR_BEAM_SIZE=5
BD_ASR_LANGUAGE=en                 # en = Latin-script Hinglish; empty = auto-detect (Hindi -> Devanagari)
BD_ASR_ALLOWED_LANGUAGES=en,hi     # detection restricted to these
BD_ASR_VAD=true
BD_ASR_INITIAL_PROMPT=             # empty = no prompt; keep any prompt short
BD_ASR_MODEL_DIR=                  # empty = Hugging Face cache
BD_ASR_LOCAL_ONLY=true             # never contact the network at startup
BD_ASR_MIN_RMS=0.01                # below this the input is treated as silence
BD_ASR_MIN_LOGPROB=-1.0            # drop segments Whisper decoded with lower confidence

# --- Local language model (Ollama) ---
BD_LLM_BACKEND=ollama
BD_LLM_MODEL=qwen2.5:3b            # or qwen2.5:1.5b
BD_LLM_ENDPOINT=http://127.0.0.1:11434
BD_LLM_TIMEOUT_S=30
BD_LLM_TEMPERATURE=0
BD_LLM_NUM_CTX=4096
BD_LLM_KEEP_ALIVE=30m
BD_LLM_ALLOW_REMOTE=false          # refuse non-loopback endpoints

# --- Vehicle limits ---
BD_TEMP_MIN_C=16
BD_TEMP_MAX_C=30
BD_FAN_MIN=0
BD_FAN_MAX=7
BD_VOLUME_MIN=0
BD_VOLUME_MAX=30

# --- Context ---
BD_CONTEXT_MAX_TURNS=6
BD_PENDING_TTL_S=60
BD_FOLLOWUP_TTL_S=120

# --- Privacy / API ---
BD_STORE_AUDIO=false
BD_AUDIO_STORE_DIR=recordings
BD_API_HOST=127.0.0.1
BD_API_PORT=8000

# --- BharatConnect (driver <-> passenger voice translation; see README) ---
# GOOGLE_APPLICATION_CREDENTIALS=C:\keys\bharat-sa.json   # service-account key (never commit it); unset = gcloud login
# GOOGLE_CLOUD_PROJECT=your-project-id                  # Cloud Translation + Text-to-Speech APIs enabled
BD_BHARAT_ASR_MODEL=small            # large-v3-turbo: much better Tamil (one-time download)
BD_BHARAT_MAX_AUDIO_S=30

# ===== Premium voice tier: Sarvam Saaras v4 ASR -> OpenAI GPT-6.1 Sol (server-side only) =====
# Keys stay on the server: never put them in the frontend or commit them. Leave empty to run free tier only.
SARVAM_API_KEY=
OPENAI_API_KEY=
BD_SARVAM_STT_MODEL=saaras:v4
BD_SARVAM_STT_MODE=codemix          # codemix | transcribe | translit | verbatim | translate
BD_SARVAM_STT_LANGUAGE=unknown      # unknown = auto-detect; or hi-IN, ta-IN, en-IN ...
BD_SARVAM_TIMEOUT_S=8
BD_SARVAM_INR_PER_HOUR=30           # Sarvam pricing page: Speech to Text, Rs 30/hour, billed per second
BD_OPENAI_MODEL=gpt-6.1-sol
BD_OPENAI_REASONING_EFFORT=low      # low | medium | high | xhigh | max (gpt-6.1-sol has no "none"/"minimal")
BD_OPENAI_TIMEOUT_S=10
BD_OPENAI_USD_PER_M_INPUT=2         # gpt-6.1-sol list price per 1M tokens
BD_OPENAI_USD_PER_M_OUTPUT=10
BD_USD_TO_INR=88
BD_ASSISTANT_RETRIES=1              # transient errors only; nothing is executed server-side, so retrying is safe
BD_ASSISTANT_MAX_AUDIO_S=20         # Sarvam REST accepts up to 30 s
BD_ASSISTANT_RATE_PER_MIN=20
BD_ASSISTANT_MIN_CONFIDENCE=0.5     # below this the assistant asks the driver to repeat
BD_ASSISTANT_USAGE_LOG=data/usage/assistant_usage.jsonl   # usage + estimated cost, no audio or transcripts
BD_ASSISTANT_LOG_TRANSCRIPTS=false  # development only

# Entitlements (who gets premium). JSON file written by your subscription system:
# {"<bearer-token>": {"tier": "premium", "subject": "user-42", "expires": "2026-12-31T23:59:59Z"}}
# BD_ENTITLEMENTS_FILE=data/entitlements.json
# Development only: lets the local cockpit switch Free/Premium from Settings (loopback requests only).
BD_DEV_TIER_SWITCH=false
BD_DEV_DEFAULT_TIER=free

# Legacy HybridASR cloud Whisper (OpenAI/Groq) for the free tier: off, so free-tier audio stays on the device.
BD_HYBRID_CLOUD_ASR=false
